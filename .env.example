# Provider Selection: "gemini" (Google), "openai" (OpenAI), or "auto"
AI_PROVIDER=gemini

# Google Gemini API Key (Obtén tu clave gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# OpenAI API Key (Obtén tu clave en https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo a utilizar
# Para Gemini: gemini-2.0-flash o gemini-1.5-flash
# Para OpenAI: gpt-4o-mini o gpt-4o
MODEL_NAME=gemini-2.0-flash

# Atajo de teclado global
HOTKEY=<ctrl>+<alt>+x

# Instrucción para la IA
PROMPT=Analiza el contenido de esta captura de pantalla y responde de forma breve, clara y concisa en español.

# Configuración de notificación sigilosa (disfraz y duración)
NOTIFICATION_TITLE=Windows Software Update
NOTIFICATION_DURATION=2
